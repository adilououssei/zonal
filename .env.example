VITE_API_URL=http://127.0.0.1:8000

# Clé "site" reCAPTCHA v3 (publique, sans risque à exposer côté client),
# obtenue sur https://www.google.com/recaptcha/admin/create. Vide en dev
# local : la vérification est alors ignorée côté backend (voir RecaptchaVerifier).
VITE_RECAPTCHA_SITE_KEY=

# Clé "site" reCAPTCHA v2 (case "Je ne suis pas un robot", formulaire de
# contact). Paire de clés distincte de la v3 : créer un second site de type
# "Défi (v2)" sur la même console.
VITE_RECAPTCHA_V2_SITE_KEY=
