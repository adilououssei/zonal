# Sert les fichiers statiques du build Vite (dist/). La ligne try_files est
# indispensable pour React Router : sans elle, recharger une URL comme
# /about ou /admin/events renvoie une 404 Nginx au lieu de laisser React
# Router afficher la bonne page côté navigateur.
#
# Ce fichier est un modèle : l'image nginx officielle remplace ${OG_API_URL}
# au démarrage du conteneur (voir le Dockerfile) avant de le copier dans
# /etc/nginx/conf.d/default.conf.

# Robots qui fabriquent l'aperçu d'un lien partagé (image + titre + résumé).
# Ils ne lisent que le HTML brut, sans exécuter React : pour eux, les pages
# de détail sont servies par le backend (LinkPreviewController), voir plus bas.
map $http_user_agent $is_link_preview_bot {
    default 0;
    "~*(facebookexternalhit|facebookcatalog|facebot|meta-externalagent|linkedinbot|twitterbot|whatsapp|telegrambot|slackbot|discordbot|pinterest|skypeuripreview|redditbot|embedly|vkshare|viber|snapchat|mastodon)" 1;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Cache la version de Nginx dans les headers/erreurs (moins d'infos pour
    # un attaquant qui chercherait une CVE connue de cette version précise).
    server_tokens off;

    # En-têtes de sécurité de base. La HSTS (Strict-Transport-Security) n'est
    # pas définie ici : elle doit être ajoutée par le reverse-proxy Nginx du
    # VPS (celui qui gère Certbot/HTTPS), jamais sur un vhost qui répond aussi
    # en HTTP, sous peine de forcer HTTPS avant que le certificat existe.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # Backend joint pour les aperçus de liens. Passer par une variable (et donc
    # un resolver) évite que Nginx refuse de démarrer si le DNS de l'API ne
    # répond pas au lancement du conteneur : seul l'aperçu serait alors indisponible.
    set $og_api "${OG_API_URL}";
    resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
    resolver_timeout 5s;
    proxy_ssl_server_name on;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Pages de détail partageables depuis l'admin (bouton « Partager ») : les
    # robots d'aperçu reçoivent la page Open Graph du backend (/og/news/12...),
    # les visiteurs reçoivent le site React comme d'habitude.
    location ~ ^/(events|news|projects|gallery)/\d+/?$ {
        if ($is_link_preview_bot) {
            rewrite ^/(events|news|projects|gallery)/(\d+)/?$ /og/$1/$2 break;
            proxy_pass $og_api;
        }
        try_files $uri /index.html;
    }

    # Cache : index.html référence le JS/CSS versionné du build. Sans Cache-Control,
    # un navigateur peut le réutiliser sans revérifier et continuer à faire tourner
    # une ancienne version du site après un déploiement. "no-cache" = toujours
    # revalider (réponse 304 légère si rien n'a changé). Les fichiers de assets/
    # ont un nom qui change avec leur contenu : cache long, sans risque.
    # (Un add_header dans un location remplace ceux du serveur : d'où la répétition
    # des en-têtes de sécurité ci-dessous.)
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    access_log /var/log/nginx/zonal_frontend_access.log;
    error_log /var/log/nginx/zonal_frontend_error.log;
}
